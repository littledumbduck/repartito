{
  "name": "repartito",
  "productName": "Repartito",
  "version": "0.1.1",
  "description": "Una mascota de escritorio que te cuenta cómo va tu pedido a domicilio. Proyecto no oficial.",
  "main": "src/main/main.js",
  "author": "Repartito contributors",
  "license": "MIT",
  "homepage": "https://github.com/littledumbduck/repartito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littledumbduck/repartito.git"
  },
  "bugs": {
    "url": "https://github.com/littledumbduck/repartito/issues"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "delivery",
    "overlay",
    "glovo"
  ],
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run icons && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.repartito.app",
    "productName": "Repartito",
    "publish": [{ "provider": "github", "owner": "littledumbduck", "repo": "repartito" }],
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/leaflet/dist/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "artifactName": "Repartito-Instalador-${version}.exe",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "3082"
    }
  }
}
